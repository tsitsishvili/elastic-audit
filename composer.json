{
    "name": "tsitsishvili/elastic-audit",
    "description": "Laravel audit logging and application performance monitoring for Elasticsearch, with redaction, queued indexing, traces, profiles, and dashboards.",
    "type": "library",
    "keywords": [
        "laravel",
        "elasticsearch",
        "audit",
        "audit-log",
        "audit-trail",
        "logging",
        "http-client",
        "http-logging",
        "activity-log",
        "observability",
        "guzzle",
        "redaction"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "tsitsishvili",
            "email": "torniketsitsishvili@gmail.com",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0 || ^13.0",
        "elasticsearch/elasticsearch": "^8.5 || ^9.0",
        "guzzlehttp/guzzle": "^7.15.2",
        "guzzlehttp/promises": "^2.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^10.0 || ^11.0 || ^12.0"
    },
    "suggest": {
        "ext-excimer": "Recommended low-overhead sampling profiler for continuous production profiles.",
        "ext-xhprof": "Optional instrumentation profiler for detailed, opt-in PHP call profiles."
    },
    "autoload": {
        "psr-4": {
            "Tsitsishvili\\ElasticAudit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tsitsishvili\\ElasticAudit\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tsitsishvili\\ElasticAudit\\ElasticAuditServiceProvider"
            ],
            "aliases": {
                "HttpLog": "Tsitsishvili\\ElasticAudit\\Facades\\HttpLog",
                "ActivityLog": "Tsitsishvili\\ElasticAudit\\Facades\\ActivityLog"
            }
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=1G --no-progress --debug",
        "format": "pint",
        "format:test": "pint --test",
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
